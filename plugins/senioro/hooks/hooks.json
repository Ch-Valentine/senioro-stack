{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-guard.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create|merge)_(pull|merge)_request",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/pr-guard.sh\""
          }
        ]
      }
    ]
  }
}
